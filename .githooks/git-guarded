#!/bin/sh
# Git wrapper that closes the hook coverage gap.
#
# Git provides no hook for working-tree-only commands, so `clean`, `checkout --force`,
# `restore --worktree`, and `gc --prune` are invisible to every hook. This wrapper is
# the only surface that can refuse them before the real git process runs.
#
# Install for external tooling by putting this directory ahead of git on PATH under
# the name `git`, or by pointing a tool's git binary at this script:
#
#   export PATH="/path/to/repo/.githooks/bin:$PATH"   # see install-workspace-guards
#   alias git='/path/to/repo/.githooks/git-guarded'
#
# Bypass, deliberately verbose and deliberately not a flag:
#   AGENTIC_WORKSPACE_GUARD_BYPASS=i-accept-destroying-unrecoverable-work git clean -fdx
set -eu

real_git="${AGENTIC_REAL_GIT:-}"
if [ -z "$real_git" ]; then
  # Resolve the first git on PATH that is not this wrapper.
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  for candidate in $(command -v -a git 2>/dev/null || true); do
    resolved="$(cd "$(dirname "$candidate")" && pwd)/$(basename "$candidate")"
    if [ "$resolved" != "$self" ]; then
      real_git="$candidate"
      break
    fi
  done
fi
[ -n "$real_git" ] || real_git=/usr/bin/git

# Only review inside a worktree; outside one there is no lane to protect.
if "$real_git" rev-parse --show-toplevel >/dev/null 2>&1; then
  root="$("$real_git" rev-parse --show-toplevel)"
  guard="$root/scripts/workspace-guard-hook.mjs"
  if [ -z "${AGENTIC_WORKSPACE_GUARD_HOME:-}" ] && [ ! -f "$guard" ]; then
    guard=""
  fi
  [ -n "$guard" ] || guard="${AGENTIC_WORKSPACE_GUARD_HOME:-}/scripts/workspace-guard-hook.mjs"
  if [ -f "$guard" ] && command -v node >/dev/null 2>&1; then
    node "$guard" review "$@" || exit 1
  fi
fi

exec "$real_git" "$@"
