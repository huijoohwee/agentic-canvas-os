#!/bin/sh
set -eu

unmerged_paths="$(git diff --name-only --diff-filter=U)"
unmerged_index="$(git ls-files -u)"

if [ -n "$unmerged_paths" ] || [ -n "$unmerged_index" ]; then
  echo "Resolve every merge conflict before committing changes." >&2
  [ -n "$unmerged_paths" ] && echo "$unmerged_paths" >&2
  exit 1
fi

root="$(git rev-parse --show-toplevel)"
worktrees="$(git worktree list --porcelain | sed -n 's/^worktree //p')"

if ! printf '%s\n' "$worktrees" | grep -F -x -- "$root" >/dev/null; then
  echo "Commit only from a live registered worktree; current: $root; registered: ${worktrees:-none}" >&2
  exit 1
fi

# The writer-lease authority gate lives in pre-push, not here. A commit reaches
# only this run's own lane, so lapsed or drifted authority must never block it:
# recording proceeds, the lane carries unreconciled commits, and reconciliation
# happens at renewal. Publication is where shared authority is proven. Gating here
# protected no shared state and left `--no-verify` as the only way to keep hours of
# verified authoring. Owner of the rule: the Recording Versus Publishing contract in
# huijoohwee.github.io/guidelines/agentic-sdlc-cloud-collaboration.md.

# Prove workspace lane isolation before the commit is recorded. Committing is never
# destructive, so this checks ownership collisions only and never blocks on another
# session holding uncommitted work.
if [ -f "$root/scripts/workspace-guard-hook.mjs" ]; then
  node "$root/scripts/workspace-guard-hook.mjs" pre-commit
fi
