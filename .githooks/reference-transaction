#!/bin/sh
# Fires for every ref transaction, so it catches branch deletions and rewinds from
# reset, rebase, and branch -D before the transaction commits.
# It cannot see working-tree-only commands such as clean or checkout --force;
# those are the wrapper's responsibility.
set -eu

state="${1:-}"
[ "$state" = "prepared" ] || exit 0

root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$root" ] || exit 0

guard="$root/scripts/workspace-guard-hook.mjs"
[ -f "$guard" ] || exit 0

exec node "$guard" reference-transaction "$state"
