{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-canvas-os.local/schemas/active-dirty-scope-expansion-intent-recovery-receipt.v1.schema.json",
  "responsibility": "Validate the deterministic terminal receipt while preserving historical bound authority.",
  "title": "Active dirty scope-expansion intent recovery receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "planDigest",
    "sourceEvidenceDigest",
    "authorizationDigest",
    "completeIntentDigest",
    "operationKey",
    "terminalObservationDigest",
    "sourceScopeExpansionIntentDigest",
    "recoveredScopeExpansionIntentDigest",
    "currentAuthorityDigest",
    "heartbeatLineageDigest",
    "currentLeaseDigest",
    "pullRequestMarkerDigest",
    "mutationAuthorityReceiptDigest",
    "finalReceiptDigest",
    "receiptDigest"
  ],
  "properties": {
    "schema": {
      "const": "agentic-active-dirty-scope-expansion-intent-recovery-receipt/v1"
    },
    "status": { "const": "recovered" },
    "planDigest": { "$ref": "#/$defs/digest" },
    "sourceEvidenceDigest": { "$ref": "#/$defs/digest" },
    "authorizationDigest": { "$ref": "#/$defs/digest" },
    "completeIntentDigest": { "$ref": "#/$defs/digest" },
    "operationKey": { "$ref": "#/$defs/digest" },
    "terminalObservationDigest": { "$ref": "#/$defs/digest" },
    "sourceScopeExpansionIntentDigest": { "$ref": "#/$defs/digest" },
    "recoveredScopeExpansionIntentDigest": { "$ref": "#/$defs/digest" },
    "currentAuthorityDigest": { "$ref": "#/$defs/digest" },
    "heartbeatLineageDigest": { "$ref": "#/$defs/digest" },
    "currentLeaseDigest": { "$ref": "#/$defs/digest" },
    "pullRequestMarkerDigest": { "$ref": "#/$defs/digest" },
    "mutationAuthorityReceiptDigest": { "$ref": "#/$defs/digest" },
    "finalReceiptDigest": { "$ref": "#/$defs/digest" },
    "receiptDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
