{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-canvas-os.dev/schemas/agentic-sdlc-admission-evidence/v1",
  "title": "Agentic SDLC Admission Evidence v1",
  "description": "Closed, operation-derived evidence evaluated before an Implementer may start.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runId", "requestedStage", "evaluationTime", "policyIdentity", "evaluatorIdentity", "schemaIdentity", "sourceIdentity", "operations", "predecessorReceipts", "admissionEvidence"],
  "properties": {
    "schema": {"const": "agentic-sdlc-admission-evidence/v1"},
    "runId": {"$ref": "#/$defs/nonempty"},
    "requestedStage": {"const": "admission"},
    "evaluationTime": {"$ref": "#/$defs/instant"},
    "policyIdentity": {"$ref": "#/$defs/policyIdentity"},
    "evaluatorIdentity": {"$ref": "#/$defs/evaluatorIdentity"},
    "schemaIdentity": {"$ref": "#/$defs/repositoryArtifactIdentity"},
    "sourceIdentity": {"$ref": "#/$defs/sourceIdentity"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/operation"}
    },
    "predecessorReceipts": {
      "type": "array",
      "maxItems": 0
    },
    "admissionEvidence": {"$ref": "#/$defs/admissionEvidence"}
  },
  "$defs": {
    "nonempty": {"type": "string", "pattern": "\\S"},
    "waveOrdinal": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,14}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "instant": {"type": "string", "format": "date-time"},
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonempty"}
    },
    "policyIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "digest", "guidelineVersion"],
      "properties": {
        "repository": {"$ref": "#/$defs/repository"},
        "revision": {"$ref": "#/$defs/gitRevision"},
        "digest": {"$ref": "#/$defs/sha256"},
        "guidelineVersion": {"$ref": "#/$defs/semanticVersion"}
      }
    },
    "evaluatorIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "digest", "mechanismId"],
      "properties": {
        "repository": {"$ref": "#/$defs/repository"},
        "revision": {"$ref": "#/$defs/gitRevision"},
        "digest": {"$ref": "#/$defs/sha256"},
        "mechanismId": {"$ref": "#/$defs/nonempty"}
      }
    },
    "repositoryArtifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "digest"],
      "properties": {
        "repository": {"$ref": "#/$defs/repository"},
        "revision": {"$ref": "#/$defs/gitRevision"},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "tree", "sourceDigest", "dependencyClosureDigest"],
      "properties": {
        "repository": {"$ref": "#/$defs/repository"},
        "revision": {"$ref": "#/$defs/gitRevision"},
        "tree": {"$ref": "#/$defs/gitRevision"},
        "sourceDigest": {"$ref": "#/$defs/sha256"},
        "dependencyClosureDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "stage", "mechanismId", "actorRole", "inputDigest", "resultDigest", "terminalResult", "evidenceReferences"],
      "properties": {
        "operationId": {"$ref": "#/$defs/nonempty"},
        "stage": {"const": "admission"},
        "mechanismId": {"$ref": "#/$defs/nonempty"},
        "actorRole": {"enum": ["orchestrator", "implementer", "evaluator", "operator"]},
        "inputDigest": {"$ref": "#/$defs/sha256"},
        "resultDigest": {"$ref": "#/$defs/sha256"},
        "terminalResult": {"$ref": "#/$defs/terminalResult"},
        "evidenceReferences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidenceReference"}
        }
      }
    },
    "terminalResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ran", "exitCode", "status", "summary", "counts"],
      "properties": {
        "ran": {"const": true},
        "exitCode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "status": {"enum": ["passed", "failed", "blocked"]},
        "summary": {"$ref": "#/$defs/nonempty"},
        "counts": {"$ref": "#/$defs/resultCounts"}
      }
    },
    "resultCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "errored", "skipped"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "errored": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0}
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "referenceId", "digest"],
      "properties": {
        "kind": {"enum": ["authoring-baseline", "vcc", "task", "collaboration", "dependency-admission", "execution-evaluator"]},
        "referenceId": {"$ref": "#/$defs/nonempty"},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "admissionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoringBaseline", "specificationTokenEstimate", "derivationRevision", "executionMechanisms", "vccs", "tasks", "collaboration", "dependencies", "deployBoundary"],
      "properties": {
        "authoringBaseline": {"$ref": "#/$defs/authoringBaseline"},
        "specificationTokenEstimate": {
          "type": "integer",
          "minimum": 1
        },
        "derivationRevision": {"$ref": "#/$defs/nonempty"},
        "executionMechanisms": {"$ref": "#/$defs/executionMechanisms"},
        "vccs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/vcc"}
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/task"}
        },
        "collaboration": {"$ref": "#/$defs/collaboration"},
        "dependencies": {"$ref": "#/$defs/dependencies"},
        "deployBoundary": {"$ref": "#/$defs/deployBoundary"}
      }
    },
    "authoringBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "digest", "vccRevision", "openBlockerCount", "prdReference", "tadReference", "existingVerificationLane", "attestation"],
      "properties": {
        "status": {"const": "baselined"},
        "digest": {"$ref": "#/$defs/sha256"},
        "vccRevision": {"$ref": "#/$defs/nonempty"},
        "openBlockerCount": {"const": 0},
        "prdReference": {"$ref": "#/$defs/nonempty"},
        "tadReference": {"$ref": "#/$defs/nonempty"},
        "existingVerificationLane": {"$ref": "#/$defs/nonempty"},
        "attestation": {"$ref": "#/$defs/attestation"}
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityId", "algorithm", "signature"],
      "properties": {
        "authorityId": {"$ref": "#/$defs/nonempty"},
        "algorithm": {"const": "ed25519"},
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    },
    "executionMechanisms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluator", "implementer"],
      "properties": {
        "evaluator": {"$ref": "#/$defs/executionMechanism"},
        "implementer": {"$ref": "#/$defs/executionMechanism"}
      }
    },
    "executionMechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanismId", "mechanismType", "mechanismDigest"],
      "properties": {
        "mechanismId": {"$ref": "#/$defs/nonempty"},
        "mechanismType": {"$ref": "#/$defs/nonempty"},
        "mechanismDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "vcc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conditionId", "criterionId", "endState", "statedCheck", "constraint", "behaviorClaims", "correctnessProperties"],
      "properties": {
        "conditionId": {"$ref": "#/$defs/nonempty"},
        "criterionId": {"$ref": "#/$defs/nonempty"},
        "endState": {"$ref": "#/$defs/nonempty"},
        "statedCheck": {"$ref": "#/$defs/nonempty"},
        "constraint": {"$ref": "#/$defs/nonempty"},
        "behaviorClaims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonempty"}
        },
        "bound": {"$ref": "#/$defs/vccBound"},
        "correctnessProperties": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/correctnessProperty"}
        }
      }
    },
    "vccBound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "maximum"],
      "properties": {
        "field": {
          "enum": ["tokens", "iterations", "wallClockMs", "contextTokens"]
        },
        "maximum": {"type": "integer", "minimum": 1}
      }
    },
    "correctnessProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["propertyId", "propertyClass", "statement", "iterations", "shrinking"],
      "properties": {
        "propertyId": {"$ref": "#/$defs/nonempty"},
        "propertyClass": {"$ref": "#/$defs/propertyClass"},
        "statement": {"$ref": "#/$defs/nonempty"},
        "iterations": {"type": "integer", "minimum": 2},
        "shrinking": {"const": true}
      }
    },
    "propertyClass": {"enum": ["round-trip", "invariant", "metamorphic", "idempotence", "confluence", "error-condition"]},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "text", "kind", "codeBearing", "behaviorKinds", "behaviorClaims", "vccIds", "criterionIds", "dependencyIds", "waveId", "writeSet", "sizing", "lane", "namedCheck", "existingVerificationLane", "propertyObligations", "capabilityGrants", "budgets", "circuitBreaker", "state"],
      "properties": {
        "taskId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(?:\\.[1-9][0-9]*)?$"
        },
        "text": {"$ref": "#/$defs/nonempty"},
        "kind": {"enum": ["feature", "bug-fix", "documentation", "other"]},
        "codeBearing": {"type": "boolean"},
        "behaviorKinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["parser", "serialiser", "ordering", "dedup", "aggregation"]}
        },
        "behaviorClaims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonempty"}
        },
        "vccIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonempty"}
        },
        "criterionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonempty"}
        },
        "dependencyIds": {"$ref": "#/$defs/stringList"},
        "waveId": {"$ref": "#/$defs/waveOrdinal"},
        "writeSet": {"$ref": "#/$defs/stringList"},
        "sizing": {"$ref": "#/$defs/taskSizing"},
        "lane": {"const": "authoring"},
        "namedCheck": {"$ref": "#/$defs/nonempty"},
        "existingVerificationLane": {"$ref": "#/$defs/nonempty"},
        "propertyObligations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/propertyObligation"}
        },
        "capabilityGrants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/capabilityGrant"}
        },
        "budgets": {"$ref": "#/$defs/budgets"},
        "circuitBreaker": {"$ref": "#/$defs/circuitBreaker"},
        "state": {"const": "not-started"}
      }
    },
    "taskSizing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["withinSingleBudget", "verifiableOutcomeCount", "coherentVccGroup"],
      "properties": {
        "withinSingleBudget": {"const": true},
        "verifiableOutcomeCount": {"const": 1},
        "coherentVccGroup": {"const": true}
      }
    },
    "propertyObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["propertyId", "propertyClass", "iterations", "shrinking"],
      "properties": {
        "propertyId": {"$ref": "#/$defs/nonempty"},
        "propertyClass": {"$ref": "#/$defs/propertyClass"},
        "iterations": {"type": "integer", "minimum": 2},
        "shrinking": {"const": true}
      }
    },
    "capabilityGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "intendedUse"],
      "properties": {
        "class": {"enum": ["read", "local-write", "local-execute", "environment-mutate", "irreversible", "boundary-crossing"]},
        "intendedUse": {"$ref": "#/$defs/nonempty"},
        "scope": {"$ref": "#/$defs/stringList"},
        "operatorDecisionReference": {"type": ["string", "null"]}
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "iterations", "wallClockMs", "contextTokens"],
      "properties": {
        "tokens": {"type": "integer", "minimum": 1},
        "iterations": {"type": "integer", "minimum": 1},
        "wallClockMs": {"type": "integer", "minimum": 1},
        "contextTokens": {"type": "integer", "minimum": 1}
      }
    },
    "circuitBreaker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["progressCheck", "maxConsecutiveNoProgress"],
      "properties": {
        "progressCheck": {"$ref": "#/$defs/nonempty"},
        "maxConsecutiveNoProgress": {"const": 2}
      }
    },
    "collaboration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "deviceId", "sessionId", "worktreeId", "branchId", "scopeId", "leaseEpoch", "fenceRevision", "status", "expiresAt", "declaredWriteScope", "inventoryComplete", "peerWriters"],
      "properties": {
        "actorId": {"$ref": "#/$defs/nonempty"},
        "deviceId": {"$ref": "#/$defs/nonempty"},
        "sessionId": {"$ref": "#/$defs/nonempty"},
        "worktreeId": {"$ref": "#/$defs/nonempty"},
        "branchId": {"$ref": "#/$defs/nonempty"},
        "scopeId": {"$ref": "#/$defs/nonempty"},
        "leaseEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "fenceRevision": {"$ref": "#/$defs/gitRevision"},
        "status": {"const": "active"},
        "expiresAt": {"$ref": "#/$defs/instant"},
        "declaredWriteScope": {"$ref": "#/$defs/stringList"},
        "inventoryComplete": {"type": "boolean"},
        "peerWriters": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/peerWriter"}
        }
      }
    },
    "peerWriter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "deviceId", "sessionId", "worktreeId", "branchId", "scopeId", "leaseEpoch", "fenceRevision", "status", "expiresAt", "declaredWriteScope"],
      "properties": {
        "actorId": {"$ref": "#/$defs/nonempty"},
        "deviceId": {"$ref": "#/$defs/nonempty"},
        "sessionId": {"$ref": "#/$defs/nonempty"},
        "worktreeId": {"$ref": "#/$defs/nonempty"},
        "branchId": {"$ref": "#/$defs/nonempty"},
        "scopeId": {"$ref": "#/$defs/nonempty"},
        "leaseEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "fenceRevision": {"$ref": "#/$defs/gitRevision"},
        "status": {"const": "active"},
        "expiresAt": {"$ref": "#/$defs/instant"},
        "declaredWriteScope": {"$ref": "#/$defs/stringList"}
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventoryComplete", "request"],
      "properties": {
        "inventoryComplete": {"type": "boolean"},
        "request": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/upstreamAdmissionRequest"}
          ]
        }
      }
    },
    "upstreamAdmissionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluationTime", "units", "dependencies", "requestedPlanStop"],
      "properties": {
        "evaluationTime": {"$ref": "#/$defs/instant"},
        "units": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/planUnit"}
        },
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/dependencyAdmissionRecord"}
        },
        "requestedPlanStop": {"type": "boolean"}
      }
    },
    "planUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unitId", "dependencies"],
      "properties": {
        "unitId": {"$ref": "#/$defs/nonempty"},
        "dependencies": {"$ref": "#/$defs/stringList"}
      }
    },
    "dependencyAdmissionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencyId", "capabilityId", "sourceRevision", "sourceState", "owners", "closureDigest", "evidenceRevision", "requiredChecks", "consumers", "decisionDeadline", "fallback", "projectionRequested"],
      "properties": {
        "dependencyId": {"$ref": "#/$defs/nonempty"},
        "capabilityId": {"$ref": "#/$defs/nonempty"},
        "sourceRevision": {
          "anyOf": [
            {"$ref": "#/$defs/gitRevision"},
            {"type": "null"}
          ]
        },
        "sourceState": {"enum": ["protected", "candidate", "local-only", "missing"]},
        "owners": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/dependencyOwner"}
        },
        "closureDigest": {
          "anyOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "evidenceRevision": {
          "anyOf": [
            {"$ref": "#/$defs/gitRevision"},
            {"type": "null"}
          ]
        },
        "requiredChecks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/dependencyCheck"}
        },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonempty"}
        },
        "decisionDeadline": {"$ref": "#/$defs/instant"},
        "fallback": {"$ref": "#/$defs/dependencyFallback"},
        "projectionRequested": {"type": "boolean"}
      }
    },
    "dependencyOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownerId", "scopeId", "fenceRevision"],
      "properties": {
        "ownerId": {"$ref": "#/$defs/nonempty"},
        "scopeId": {"$ref": "#/$defs/nonempty"},
        "fenceRevision": {"$ref": "#/$defs/gitRevision"}
      }
    },
    "dependencyCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status"],
      "properties": {
        "name": {"$ref": "#/$defs/nonempty"},
        "status": {"enum": ["pass", "fail", "missing"]}
      }
    },
    "dependencyFallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "capabilityId", "sourceRevision", "evidenceDigest"],
      "properties": {
        "type": {"enum": ["defer", "omit", "protected-equivalent"]},
        "capabilityId": {
          "anyOf": [
            {"$ref": "#/$defs/nonempty"},
            {"type": "null"}
          ]
        },
        "sourceRevision": {
          "anyOf": [
            {"$ref": "#/$defs/gitRevision"},
            {"type": "null"}
          ]
        },
        "evidenceDigest": {
          "anyOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        }
      }
    },
    "deployBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "state"],
      "properties": {
        "lane": {"const": "authoring"},
        "state": {"const": "closed"}
      }
    }
  }
}
