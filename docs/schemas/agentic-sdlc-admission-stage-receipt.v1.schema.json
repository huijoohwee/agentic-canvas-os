{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-canvas-os.dev/schemas/agentic-sdlc-admission-stage-receipt/v1",
  "title": "Agentic SDLC Admission Stage Receipt v1",
  "description": "A digest-bound admission verdict. It grants no review, integration, runtime, release, deployment, or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runId",
    "stage",
    "verdict",
    "ready",
    "policyRevision",
    "policyDigest",
    "evaluatorRevision",
    "evaluatorDigest",
    "schemaRevision",
    "schemaDigest",
    "sourceRevision",
    "dependencyClosureDigest",
    "inputEvidenceDigest",
    "predecessorReceiptDigest",
    "findingCounts",
    "findings",
    "findingSetDigest",
    "stageEvidence",
    "stageEvidenceDigest",
    "enforcedStages",
    "unevaluatedStages",
    "receiptDigest"
  ],
  "properties": {
    "schema": {"const": "agentic-sdlc-admission-stage-receipt/v1"},
    "runId": {"$ref": "#/$defs/nonempty"},
    "stage": {"const": "admission"},
    "verdict": {"enum": ["verified", "blocked"]},
    "ready": {"type": "boolean"},
    "policyRevision": {"$ref": "#/$defs/gitRevision"},
    "policyDigest": {"$ref": "#/$defs/sha256"},
    "evaluatorRevision": {"$ref": "#/$defs/gitRevision"},
    "evaluatorDigest": {"$ref": "#/$defs/sha256"},
    "schemaRevision": {"$ref": "#/$defs/gitRevision"},
    "schemaDigest": {"$ref": "#/$defs/sha256"},
    "sourceRevision": {"$ref": "#/$defs/gitRevision"},
    "dependencyClosureDigest": {"$ref": "#/$defs/sha256"},
    "inputEvidenceDigest": {"$ref": "#/$defs/sha256"},
    "predecessorReceiptDigest": {"const": "not-applicable"},
    "findingCounts": {"$ref": "#/$defs/findingCounts"},
    "findings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/finding"}
    },
    "findingSetDigest": {"$ref": "#/$defs/sha256"},
    "stageEvidence": {"$ref": "#/$defs/stageEvidence"},
    "stageEvidenceDigest": {"$ref": "#/$defs/sha256"},
    "enforcedStages": {"const": ["admission"]},
    "unevaluatedStages": {
      "const": [
        "review",
        "integration",
        "runtime",
        "candidate",
        "authorization",
        "deployment",
        "publication"
      ]
    },
    "receiptDigest": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"verdict": {"const": "verified"}},
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "ready": {"const": true},
          "findings": {"type": "array", "maxItems": 0}
        }
      },
      "else": {
        "properties": {
          "ready": {"const": false},
          "findings": {"type": "array", "minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "nonempty": {"type": "string", "pattern": "\\S"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "findingType": {
      "enum": [
        "runtime-readiness-unproven",
        "unnamed-evaluator",
        "self-graded-verdict",
        "ungrounded-task",
        "unexecuted-condition",
        "task-cycle",
        "concurrent-write-conflict",
        "parallel-scope-collision",
        "stale-collaboration-fence",
        "oversized-task",
        "self-escalated-capability",
        "out-of-scope-write",
        "ungated-irreversible-operation",
        "unbounded-task",
        "deploy-boundary-breach",
        "dependency-closure-drift",
        "evidence-without-run",
        "unproven-property"
      ]
    },
    "findingCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime-readiness-unproven",
        "unnamed-evaluator",
        "self-graded-verdict",
        "ungrounded-task",
        "unexecuted-condition",
        "task-cycle",
        "concurrent-write-conflict",
        "parallel-scope-collision",
        "stale-collaboration-fence",
        "oversized-task",
        "self-escalated-capability",
        "out-of-scope-write",
        "ungated-irreversible-operation",
        "unbounded-task",
        "deploy-boundary-breach",
        "dependency-closure-drift",
        "evidence-without-run",
        "unproven-property"
      ],
      "properties": {
        "runtime-readiness-unproven": {"$ref": "#/$defs/count"},
        "unnamed-evaluator": {"$ref": "#/$defs/count"},
        "self-graded-verdict": {"$ref": "#/$defs/count"},
        "ungrounded-task": {"$ref": "#/$defs/count"},
        "unexecuted-condition": {"$ref": "#/$defs/count"},
        "task-cycle": {"$ref": "#/$defs/count"},
        "concurrent-write-conflict": {"$ref": "#/$defs/count"},
        "parallel-scope-collision": {"$ref": "#/$defs/count"},
        "stale-collaboration-fence": {"$ref": "#/$defs/count"},
        "oversized-task": {"$ref": "#/$defs/count"},
        "self-escalated-capability": {"$ref": "#/$defs/count"},
        "out-of-scope-write": {"$ref": "#/$defs/count"},
        "ungated-irreversible-operation": {"$ref": "#/$defs/count"},
        "unbounded-task": {"$ref": "#/$defs/count"},
        "deploy-boundary-breach": {"$ref": "#/$defs/count"},
        "dependency-closure-drift": {"$ref": "#/$defs/count"},
        "evidence-without-run": {"$ref": "#/$defs/count"},
        "unproven-property": {"$ref": "#/$defs/count"}
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findingType",
        "severity",
        "guidelineAnchor",
        "artifactReference",
        "evidenceExcerpt",
        "remediation"
      ],
      "properties": {
        "findingType": {"$ref": "#/$defs/findingType"},
        "severity": {"enum": ["blocker", "major", "minor"]},
        "guidelineAnchor": {
          "type": "string",
          "pattern": "^[a-z0-9-]+#[1-9][0-9]*$"
        },
        "artifactReference": {"$ref": "#/$defs/nonempty"},
        "evidenceExcerpt": {"$ref": "#/$defs/nonempty"},
        "remediation": {"$ref": "#/$defs/remediation"}
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "statement",
        "state",
        "operatorInstructionRef"
      ],
      "properties": {
        "class": {
          "enum": [
            "documentation-change",
            "specification-change",
            "local-reproducible-check"
          ]
        },
        "statement": {"$ref": "#/$defs/nonempty"},
        "state": {
          "enum": ["proposed", "deploy-gated", "operator-approved"]
        },
        "operatorInstructionRef": {"type": ["string", "null"]}
      }
    },
    "stageEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "inventoryComplete",
        "authoringBaselineDigest",
        "taskPlanDigest",
        "vccTaskClosureDigest",
        "budgetDigest",
        "capabilityGrantDigest",
        "collaborationIdentityDigest",
        "dependencyAdmissionDigest",
        "evaluatorDigest",
        "namedChecksDigest",
        "coverage"
      ],
      "properties": {
        "schema": {"const": "agentic-sdlc-admission-stage-evidence/v1"},
        "inventoryComplete": {"type": "boolean"},
        "authoringBaselineDigest": {"$ref": "#/$defs/sha256"},
        "taskPlanDigest": {"$ref": "#/$defs/sha256"},
        "vccTaskClosureDigest": {"$ref": "#/$defs/sha256"},
        "budgetDigest": {"$ref": "#/$defs/sha256"},
        "capabilityGrantDigest": {"$ref": "#/$defs/sha256"},
        "collaborationIdentityDigest": {"$ref": "#/$defs/sha256"},
        "dependencyAdmissionDigest": {"$ref": "#/$defs/sha256"},
        "evaluatorDigest": {"$ref": "#/$defs/sha256"},
        "namedChecksDigest": {"$ref": "#/$defs/sha256"},
        "coverage": {"$ref": "#/$defs/coverage"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["covered", "total"],
      "properties": {
        "covered": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
