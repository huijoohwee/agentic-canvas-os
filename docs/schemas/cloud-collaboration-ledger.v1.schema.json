{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-canvas-os.dev/schemas/cloud-collaboration-ledger/v1",
  "title": "Agentic Cloud Collaboration Ledger v1",
  "description": "A closed append-only ledger. Historical entry/v1 bytes remain immutable; all new authority transitions use entry/v2 and exactly claim, continue, integrate, or retire. No repository, integration, release, Production, or deployment authority follows from schema validity alone.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ledgerRepositoryId", "sequence", "headDigest", "entries"],
  "properties": {
    "schema": { "const": "agentic-cloud-collaboration-ledger/v1" },
    "ledgerRepositoryId": { "$ref": "#/$defs/identifier" },
    "sequence": { "type": "integer", "minimum": 0 },
    "headDigest": { "$ref": "#/$defs/nullableSha256" },
    "entries": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "sequence": { "const": 0 } },
        "required": ["sequence"]
      },
      "then": {
        "properties": {
          "headDigest": { "type": "null" },
          "entries": { "maxItems": 0 }
        }
      },
      "else": {
        "properties": {
          "headDigest": { "$ref": "#/$defs/sha256" },
          "entries": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableSha256": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/sha256" }
      ]
    },
    "nullableIdentifier": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/identifier" }
      ]
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "nullableInstant": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/instant" }
      ]
    },
    "writeScope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 517,
        "pattern": "^(?:path:.+|semantic:[a-z0-9][a-z0-9._:/-]*)$"
      }
    },
    "canonicalDescendantProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "sourceBaseSha", "targetBaseSha", "protectedMainSha",
        "canonicalChangedPaths", "canonicalChangedPathsDigest", "preservedChangedPaths",
        "preservedChangedPathsDigest", "ancestry", "overlap", "evidenceDigest"
      ],
      "properties": {
        "schema": { "const": "agentic-legacy-review-current-base-disjoint-proof/v1" },
        "sourceBaseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "targetBaseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "protectedMainSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "canonicalChangedPaths": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "canonicalChangedPathsDigest": { "$ref": "#/$defs/sha256" },
        "preservedChangedPaths": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "preservedChangedPathsDigest": { "$ref": "#/$defs/sha256" },
        "ancestry": { "const": "source-base-to-current-protected-main" },
        "overlap": { "const": "none" },
        "evidenceDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "nextActorId", "evidenceDigest", "evaluationTime"],
      "properties": {
        "mode": { "enum": ["actor", "open"] },
        "nextActorId": { "$ref": "#/$defs/nullableIdentifier" },
        "evidenceDigest": { "$ref": "#/$defs/sha256" },
        "evaluationTime": { "$ref": "#/$defs/instant" }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "evidenceDigest", "integrationReceiptDigest", "evaluationTime"],
      "properties": {
        "reason": { "enum": ["integrated", "abandoned", "handoff"] },
        "evidenceDigest": { "$ref": "#/$defs/sha256" },
        "integrationReceiptDigest": { "$ref": "#/$defs/nullableSha256" },
        "evaluationTime": { "$ref": "#/$defs/instant" }
      }
    },
    "deliveryAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluationTime", "focusedEvidenceDigest", "integrationIntentDigest", "operatorDecisionDigest"],
      "properties": {
        "evaluationTime": { "$ref": "#/$defs/instant" },
        "focusedEvidenceDigest": { "$ref": "#/$defs/sha256" },
        "integrationIntentDigest": { "$ref": "#/$defs/sha256" },
        "operatorDecisionDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "legacyClaimCore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimId", "actorId", "deviceId", "sessionId", "repositoryId", "workItemId",
        "canonicalBaseRevision", "declaredWriteScope", "writeSetDigest", "laneRevision",
        "leaseEpoch", "transitionCounter", "heartbeatCounter", "state", "expiresAt",
        "evidenceDigest", "reviewRequestId", "predecessorClaimId", "handoff", "release"
      ],
      "properties": {
        "claimId": { "$ref": "#/$defs/sha256" },
        "actorId": { "$ref": "#/$defs/identifier" },
        "deviceId": { "$ref": "#/$defs/identifier" },
        "sessionId": { "$ref": "#/$defs/identifier" },
        "repositoryId": { "$ref": "#/$defs/identifier" },
        "workItemId": { "$ref": "#/$defs/identifier" },
        "canonicalBaseRevision": { "$ref": "#/$defs/identifier" },
        "declaredWriteScope": { "$ref": "#/$defs/writeScope" },
        "writeSetDigest": { "$ref": "#/$defs/sha256" },
        "laneRevision": { "$ref": "#/$defs/identifier" },
        "leaseEpoch": { "type": "integer", "minimum": 1 },
        "transitionCounter": { "type": "integer", "minimum": 1 },
        "heartbeatCounter": { "type": "integer", "minimum": 0 },
        "state": { "enum": ["active", "review-ready", "delivery-authorized", "parked", "released"] },
        "expiresAt": { "$ref": "#/$defs/instant" },
        "evidenceDigest": { "$ref": "#/$defs/nullableSha256" },
        "reviewRequestId": { "$ref": "#/$defs/nullableIdentifier" },
        "predecessorClaimId": { "$ref": "#/$defs/nullableSha256" },
        "handoff": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/handoff" }]
        },
        "release": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/release" }]
        },
        "deliveryAuthorization": { "$ref": "#/$defs/deliveryAuthorization" }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceDigest", "recoveredAt"],
      "properties": {
        "evidenceDigest": { "$ref": "#/$defs/sha256" },
        "recoveredAt": { "$ref": "#/$defs/instant" }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateRevision", "reviewRequestId", "focusedEvidenceDigest", "dependencyClosureDigest",
        "namedChecksDigest", "handoffEvidenceDigest", "operatorDecisionDigest",
        "integrationIntentDigest", "integratedAt"
      ],
      "properties": {
        "candidateRevision": { "$ref": "#/$defs/identifier" },
        "reviewRequestId": { "$ref": "#/$defs/identifier" },
        "focusedEvidenceDigest": { "$ref": "#/$defs/sha256" },
        "dependencyClosureDigest": { "$ref": "#/$defs/sha256" },
        "namedChecksDigest": { "$ref": "#/$defs/sha256" },
        "handoffEvidenceDigest": { "$ref": "#/$defs/sha256" },
        "operatorDecisionDigest": { "$ref": "#/$defs/sha256" },
        "integrationIntentDigest": { "$ref": "#/$defs/sha256" },
        "integratedAt": { "$ref": "#/$defs/instant" }
      }
    },
    "retirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason", "finalRevision", "reviewRequestId", "bytesDigest", "namedChecksDigest",
        "handoffEvidenceDigest", "integrationReceiptDigest", "retiredAt"
      ],
      "properties": {
        "reason": { "enum": ["integrated", "abandoned", "handoff", "superseded"] },
        "finalRevision": { "$ref": "#/$defs/identifier" },
        "reviewRequestId": { "$ref": "#/$defs/nullableIdentifier" },
        "bytesDigest": { "$ref": "#/$defs/sha256" },
        "namedChecksDigest": { "$ref": "#/$defs/sha256" },
        "handoffEvidenceDigest": { "$ref": "#/$defs/sha256" },
        "integrationReceiptDigest": { "$ref": "#/$defs/nullableSha256" },
        "retiredAt": { "$ref": "#/$defs/instant" }
      }
    },
    "currentClaimCore": {
      "type": "object",
      "$comment": "Only the derived current state has write authority. waiting-successor is queued and non-writing; reviewed, integrated-preserved, and dormant-preserved retain scope reservation without write authority; retired retains neither.",
      "additionalProperties": false,
      "required": [
        "claimId", "actorId", "deviceId", "sessionId", "repositoryId", "workItemId",
        "canonicalBaseRevision", "declaredWriteScope", "writeSetDigest", "laneRevision",
        "leaseEpoch", "transitionCounter", "heartbeatCounter", "state", "expiresAt",
        "evidenceDigest", "reviewRequestId", "predecessorClaimId", "eligibleSince", "handoff", "release"
      ],
      "properties": {
        "claimId": { "$ref": "#/$defs/sha256" },
        "actorId": { "$ref": "#/$defs/identifier" },
        "deviceId": { "$ref": "#/$defs/identifier" },
        "sessionId": { "$ref": "#/$defs/identifier" },
        "repositoryId": { "$ref": "#/$defs/identifier" },
        "workItemId": { "$ref": "#/$defs/identifier" },
        "canonicalBaseRevision": { "$ref": "#/$defs/identifier" },
        "declaredWriteScope": { "$ref": "#/$defs/writeScope" },
        "writeSetDigest": { "$ref": "#/$defs/sha256" },
        "laneRevision": { "$ref": "#/$defs/identifier" },
        "leaseEpoch": { "type": "integer", "minimum": 1 },
        "transitionCounter": { "type": "integer", "minimum": 1 },
        "heartbeatCounter": { "type": "integer", "minimum": 0 },
        "state": {
          "enum": [
            "current", "waiting-successor", "reviewed", "integrated-preserved",
            "dormant-preserved", "retired"
          ]
        },
        "expiresAt": { "$ref": "#/$defs/instant" },
        "evidenceDigest": { "$ref": "#/$defs/nullableSha256" },
        "reviewRequestId": { "$ref": "#/$defs/nullableIdentifier" },
        "predecessorClaimId": { "$ref": "#/$defs/nullableSha256" },
        "canonicalDescendantProof": { "$ref": "#/$defs/canonicalDescendantProof" },
        "eligibleSince": { "$ref": "#/$defs/nullableInstant" },
        "handoff": { "type": "null" },
        "release": { "type": "null" },
        "handoffEvidenceDigest": { "$ref": "#/$defs/sha256" },
        "promotedAt": { "$ref": "#/$defs/instant" },
        "recovery": { "$ref": "#/$defs/recovery" },
        "integration": { "$ref": "#/$defs/integration" },
        "retirement": { "$ref": "#/$defs/retirement" }
      }
    },
    "entryBase": {
      "type": "object",
      "$comment": "parentDigest is the persisted monotonic-CAS predecessor. Runtime validation additionally proves sequence continuity, digest reconstruction, and headDigest equality.",
      "required": [
        "schema", "sequence", "parentDigest", "action", "repositoryId", "claimId",
        "idempotencyKey", "requestDigest", "evaluationTime", "claimCore", "claimDigest", "digest"
      ],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "parentDigest": { "$ref": "#/$defs/nullableSha256" },
        "repositoryId": { "$ref": "#/$defs/identifier" },
        "claimId": { "$ref": "#/$defs/sha256" },
        "idempotencyKey": { "$ref": "#/$defs/sha256" },
        "requestDigest": { "$ref": "#/$defs/sha256" },
        "evaluationTime": { "$ref": "#/$defs/instant" },
        "claimDigest": { "$ref": "#/$defs/sha256" },
        "digest": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "sequence": { "const": 1 } },
            "required": ["sequence"]
          },
          "then": { "properties": { "parentDigest": { "type": "null" } } },
          "else": { "properties": { "parentDigest": { "$ref": "#/$defs/sha256" } } }
        }
      ]
    },
    "legacyEntry": {
      "allOf": [
        { "$ref": "#/$defs/entryBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema": { "const": "agentic-cloud-collaboration-entry/v1" },
            "sequence": true,
            "parentDigest": true,
            "action": { "enum": ["claim", "bind", "heartbeat", "review-ready", "delivery-authorize", "handoff", "release"] },
            "repositoryId": true,
            "claimId": true,
            "idempotencyKey": true,
            "requestDigest": true,
            "evaluationTime": true,
            "claimCore": { "$ref": "#/$defs/legacyClaimCore" },
            "claimDigest": true,
            "digest": true
          }
        }
      ]
    },
    "currentEntryBase": {
      "allOf": [
        { "$ref": "#/$defs/entryBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema": { "const": "agentic-cloud-collaboration-entry/v2" },
            "sequence": true,
            "parentDigest": true,
            "action": { "enum": ["claim", "continue", "integrate", "retire"] },
            "repositoryId": true,
            "claimId": true,
            "idempotencyKey": true,
            "requestDigest": true,
            "evaluationTime": true,
            "claimCore": { "$ref": "#/$defs/currentClaimCore" },
            "claimDigest": true,
            "digest": true
          }
        }
      ]
    },
    "currentClaimEntry": {
      "allOf": [
        { "$ref": "#/$defs/currentEntryBase" },
        {
          "properties": {
            "action": { "const": "claim" },
            "claimCore": {
              "allOf": [
                { "$ref": "#/$defs/currentClaimCore" },
                {
                  "properties": {
                    "state": { "enum": ["current", "waiting-successor"] },
                    "transitionCounter": { "const": 1 },
                    "evidenceDigest": { "type": "null" },
                    "reviewRequestId": { "type": "null" }
                  },
                  "not": {
                    "anyOf": [
                      { "required": ["handoffEvidenceDigest"] },
                      { "required": ["promotedAt"] },
                      { "required": ["recovery"] },
                      { "required": ["integration"] },
                      { "required": ["retirement"] }
                    ]
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": { "state": { "const": "waiting-successor" } },
                        "required": ["state"]
                      },
                      "then": {
                        "properties": {
                          "predecessorClaimId": { "$ref": "#/$defs/sha256" },
                          "eligibleSince": { "$ref": "#/$defs/instant" }
                        }
                      },
                      "else": { "properties": { "eligibleSince": { "type": "null" } } }
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "currentContinuationEntry": {
      "allOf": [
        { "$ref": "#/$defs/currentEntryBase" },
        {
          "properties": {
            "action": { "const": "continue" },
            "claimCore": {
              "allOf": [
                { "$ref": "#/$defs/currentClaimCore" },
                {
                  "properties": {
                    "state": {
                      "enum": ["current", "reviewed", "integrated-preserved", "dormant-preserved"]
                    }
                  },
                  "not": { "required": ["retirement"] },
                  "allOf": [
                    {
                      "if": { "properties": { "state": { "const": "reviewed" } } },
                      "then": {
                        "properties": {
                          "evidenceDigest": { "$ref": "#/$defs/sha256" },
                          "reviewRequestId": { "$ref": "#/$defs/identifier" }
                        }
                      }
                    },
                    {
                      "if": { "properties": { "state": { "const": "integrated-preserved" } } },
                      "then": { "required": ["integration"] }
                    },
                    {
                      "if": { "properties": { "state": { "const": "dormant-preserved" } } },
                      "then": { "required": ["handoffEvidenceDigest"] }
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "currentIntegrationEntry": {
      "allOf": [
        { "$ref": "#/$defs/currentEntryBase" },
        {
          "properties": {
            "action": { "const": "integrate" },
            "claimCore": {
              "allOf": [
                { "$ref": "#/$defs/currentClaimCore" },
                {
                  "properties": { "state": { "const": "integrated-preserved" } },
                  "required": ["integration"],
                  "not": { "required": ["retirement"] }
                }
              ]
            }
          }
        }
      ]
    },
    "currentRetirementEntry": {
      "allOf": [
        { "$ref": "#/$defs/currentEntryBase" },
        {
          "properties": {
            "action": { "const": "retire" },
            "claimCore": {
              "allOf": [
                { "$ref": "#/$defs/currentClaimCore" },
                {
                  "properties": { "state": { "const": "retired" } },
                  "required": ["retirement"],
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "retirement": {
                            "properties": { "reason": { "const": "integrated" } },
                            "required": ["reason"]
                          }
                        },
                        "required": ["retirement"]
                      },
                      "then": {
                        "required": ["integration"],
                        "properties": {
                          "retirement": {
                            "properties": {
                              "integrationReceiptDigest": { "$ref": "#/$defs/sha256" }
                            }
                          }
                        }
                      },
                      "else": {
                        "not": { "required": ["integration"] },
                        "properties": {
                          "retirement": {
                            "properties": { "integrationReceiptDigest": { "type": "null" } }
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "typedOperationReceipt": {
      "$comment": "Typed receipts are returned projections bound to an immutable entry digest; they are not embedded in the ledger and grant no separate authority.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "operation", "status", "repositoryId", "claimId", "claimDigest",
        "fenceRevision", "ledgerRevision", "ledgerSequence", "idempotencyKey",
        "requestDigest", "evaluationTime", "receiptDigest"
      ],
      "properties": {
        "schema": {
          "enum": [
            "agentic-collaboration-claim-receipt/v1",
            "agentic-collaboration-continuation-receipt/v1",
            "agentic-collaboration-integration-receipt/v1",
            "agentic-collaboration-retirement-receipt/v1"
          ]
        },
        "operation": { "enum": ["claim", "continue", "integrate", "retire"] },
        "status": {
          "enum": [
            "current", "waiting-successor", "reviewed", "integrated-preserved",
            "dormant-preserved", "retired"
          ]
        },
        "repositoryId": { "$ref": "#/$defs/identifier" },
        "claimId": { "$ref": "#/$defs/sha256" },
        "claimDigest": { "$ref": "#/$defs/sha256" },
        "fenceRevision": { "$ref": "#/$defs/sha256" },
        "ledgerRevision": { "$ref": "#/$defs/sha256" },
        "ledgerSequence": { "type": "integer", "minimum": 1 },
        "idempotencyKey": { "$ref": "#/$defs/sha256" },
        "requestDigest": { "$ref": "#/$defs/sha256" },
        "evaluationTime": { "$ref": "#/$defs/instant" },
        "receiptDigest": { "$ref": "#/$defs/sha256" }
      },
      "oneOf": [
        {
          "properties": {
            "schema": { "const": "agentic-collaboration-claim-receipt/v1" },
            "operation": { "const": "claim" },
            "status": { "enum": ["current", "waiting-successor"] }
          }
        },
        {
          "properties": {
            "schema": { "const": "agentic-collaboration-continuation-receipt/v1" },
            "operation": { "const": "continue" },
            "status": {
              "enum": ["current", "reviewed", "integrated-preserved", "dormant-preserved"]
            }
          }
        },
        {
          "properties": {
            "schema": { "const": "agentic-collaboration-integration-receipt/v1" },
            "operation": { "const": "integrate" },
            "status": { "const": "integrated-preserved" }
          }
        },
        {
          "properties": {
            "schema": { "const": "agentic-collaboration-retirement-receipt/v1" },
            "operation": { "const": "retire" },
            "status": { "const": "retired" }
          }
        }
      ]
    },
    "entry": {
      "oneOf": [
        { "$ref": "#/$defs/legacyEntry" },
        { "$ref": "#/$defs/currentClaimEntry" },
        { "$ref": "#/$defs/currentContinuationEntry" },
        { "$ref": "#/$defs/currentIntegrationEntry" },
        { "$ref": "#/$defs/currentRetirementEntry" }
      ]
    }
  }
}
