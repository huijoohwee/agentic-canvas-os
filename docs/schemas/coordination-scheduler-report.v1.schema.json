{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-canvas-os.dev/schemas/coordination-scheduler-report/v1",
  "title": "Coordination Scheduler Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "inputDigest", "capacity", "waves", "ready", "waiting", "blocked", "nonBlockingAttention", "summary", "mutation", "reportDigest"],
  "properties": {
    "schema": { "const": "agentic-coordination-scheduler-report/v1" },
    "inputDigest": { "$ref": "#/$defs/digest" },
    "capacity": { "type": "integer", "minimum": 1 },
    "waves": { "type": "array", "items": { "$ref": "#/$defs/wave" } },
    "ready": { "type": "array", "items": { "$ref": "#/$defs/disposition" } },
    "waiting": { "type": "array", "items": { "$ref": "#/$defs/disposition" } },
    "blocked": { "type": "array", "items": { "$ref": "#/$defs/disposition" } },
    "nonBlockingAttention": { "type": "array", "items": { "$ref": "#/$defs/attention" } },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "ready", "waiting", "blocked", "waves"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "ready": { "type": "integer", "minimum": 0 },
        "waiting": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "waves": { "type": "integer", "minimum": 0 }
      }
    },
    "mutation": { "const": false },
    "reportDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "wave": {
      "type": "object", "additionalProperties": false, "required": ["index", "taskIds"],
      "properties": { "index": { "type": "integer", "minimum": 0 }, "taskIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } }
    },
    "disposition": {
      "type": "object", "additionalProperties": false,
      "required": ["taskId", "disposition", "reason", "related", "wave"],
      "properties": {
        "taskId": { "type": "string", "minLength": 1 },
        "disposition": { "enum": ["ready", "waiting", "blocked"] },
        "reason": { "type": "string", "minLength": 1 },
        "related": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "wave": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] }
      }
    },
    "attention": {
      "type": "object", "additionalProperties": false,
      "required": ["taskId", "code", "blockScope", "affectedWriteSet", "evidenceDigest"],
      "properties": {
        "taskId": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "blockScope": { "const": "global" },
        "affectedWriteSet": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:path:.+|semantic:[a-z0-9][a-z0-9._:/-]*)$" } },
        "evidenceDigest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
