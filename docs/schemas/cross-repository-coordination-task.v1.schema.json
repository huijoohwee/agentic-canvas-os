{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-canvas-os.dev/schemas/cross-repository-coordination-task/v1",
  "title": "Cross-repository coordination task v1",
  "description": "A dependency-ordered group of immutable repository work units. Validation grants no mutation, integration, release, Production, publication, or deployment authority.",
  "$comment": "The executable validator additionally proves unique unit, worktree, claim, and repository-branch identities; exactly one unit pinned to the source-guideline repository and revision; task-digest-bound authenticated repository authority identities; exact write-set and task digests; known non-self edges; at least two repositories; semantic-scope equality; and an acyclic dependency graph.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "taskId", "semanticScope", "sourceGuideline", "units", "dependencyEdges", "taskDigest"
  ],
  "properties": {
    "schema": { "const": "agentic-cross-repository-coordination-task/v1" },
    "taskId": { "$ref": "#/$defs/text" },
    "semanticScope": { "$ref": "#/$defs/text" },
    "sourceGuideline": { "$ref": "#/$defs/sourceGuideline" },
    "units": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/unit" }
    },
    "dependencyEdges": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/dependencyEdge" }
    },
    "taskDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "fence": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "writeScope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 517,
        "pattern": "^(?:path:.+|semantic:[a-z0-9][a-z0-9._:/-]*)$"
      }
    },
    "sourceGuideline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "tree", "guidelineDigest", "companionDigest"],
      "properties": {
        "repository": { "$ref": "#/$defs/text" },
        "revision": { "$ref": "#/$defs/gitRevision" },
        "tree": { "$ref": "#/$defs/gitRevision" },
        "guidelineDigest": { "$ref": "#/$defs/sha256" },
        "companionDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "unit": {
      "type": "object",
      "$comment": "Every closed unit retains its own repository, authenticated repository authority identity, branch, worktree, semantic scope, normalized write set, claim, authority epoch, fence, pull-request projection, checks, source identity, and handoff evidence. None is shared by task identity.",
      "additionalProperties": false,
      "required": [
        "unitId", "repository", "repositoryId", "branch", "worktree", "semanticScope", "declaredWriteScope",
        "writeSetDigest", "claimId", "authorityEpoch", "fence", "pullRequest", "sourceRevision",
        "sourceDigest", "namedChecks", "handoffEvidenceDigest"
      ],
      "properties": {
        "unitId": { "$ref": "#/$defs/text" },
        "repository": { "$ref": "#/$defs/text" },
        "repositoryId": { "$ref": "#/$defs/text" },
        "branch": { "$ref": "#/$defs/text" },
        "worktree": { "$ref": "#/$defs/text" },
        "semanticScope": { "$ref": "#/$defs/text" },
        "declaredWriteScope": { "$ref": "#/$defs/writeScope" },
        "writeSetDigest": { "$ref": "#/$defs/sha256" },
        "claimId": { "$ref": "#/$defs/sha256" },
        "authorityEpoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "fence": { "$ref": "#/$defs/fence" },
        "pullRequest": { "$ref": "#/$defs/text" },
        "sourceRevision": { "$ref": "#/$defs/gitRevision" },
        "sourceDigest": { "$ref": "#/$defs/sha256" },
        "namedChecks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        },
        "handoffEvidenceDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "dependencyEdge": {
      "type": "object",
      "$comment": "from and to are unitId values. Referential integrity, non-self edges, uniqueness, and acyclicity are fail-closed runtime invariants.",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/text" },
        "to": { "$ref": "#/$defs/text" }
      }
    }
  }
}
