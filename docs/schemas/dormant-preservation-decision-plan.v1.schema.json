{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-canvas-os.local/schemas/dormant-preservation-decision-plan.v1.schema.json",
  "responsibility": "Validate receipt-bound dormant-preservation admission plans and their nested device-start invocation.",
  "title": "Dormant-preservation admission plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "sourceEvidence",
    "sourceEvidenceDigest",
    "nestedDeviceStart",
    "planDigest",
    "exactAuthorization",
    "deviceStartArgv",
    "deviceStartArgvDigest"
  ],
  "properties": {
    "schema": {
      "const": "agentic-dormant-preservation-admission-plan/v1"
    },
    "operation": {
      "const": "dormant-preservation-admission"
    },
    "sourceEvidence": { "$ref": "#/$defs/sourceEvidence" },
    "sourceEvidenceDigest": { "$ref": "#/$defs/digest" },
    "nestedDeviceStart": { "$ref": "#/$defs/deviceStart" },
    "planDigest": { "$ref": "#/$defs/digest" },
    "exactAuthorization": {
      "type": "string",
      "pattern": "^authorize dormant-preservation-admission [0-9a-f]{64}$"
    },
    "deviceStartArgv": { "$ref": "#/$defs/argv" },
    "deviceStartArgvDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/"
    },
    "argv": {
      "type": "array",
      "minItems": 3,
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deviceStart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "executable",
        "cwd",
        "argvTemplate",
        "derivedBindings"
      ],
      "properties": {
        "schema": {
          "const": "agentic-dormant-preservation-device-start-invocation/v1"
        },
        "executable": { "$ref": "#/$defs/absolutePath" },
        "cwd": { "$ref": "#/$defs/absolutePath" },
        "argvTemplate": { "$ref": "#/$defs/argv" },
        "derivedBindings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operatorDecisionDigest", "authorization"],
          "properties": {
            "operatorDecisionDigest": { "const": "planDigest" },
            "authorization": { "const": "exactAuthorization" }
          }
        }
      }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "controller",
        "canonical",
        "candidate",
        "cloudInventory",
        "preservation",
        "sourceEvidenceDigest"
      ],
      "properties": {
        "schema": {
          "const": "agentic-dormant-preservation-admission-source-evidence/v1"
        },
        "controller": { "$ref": "#/$defs/controller" },
        "canonical": { "$ref": "#/$defs/canonical" },
        "candidate": { "$ref": "#/$defs/candidate" },
        "cloudInventory": { "$ref": "#/$defs/cloudInventory" },
        "preservation": { "$ref": "#/$defs/preservation" },
        "sourceEvidenceDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "origin",
        "headSha",
        "originMainSha",
        "remoteMainSha",
        "treeSha",
        "clean",
        "deviceBranchScriptDigest"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "origin": { "type": "string", "minLength": 1 },
        "headSha": { "$ref": "#/$defs/sha" },
        "originMainSha": { "$ref": "#/$defs/sha" },
        "remoteMainSha": { "$ref": "#/$defs/sha" },
        "treeSha": { "$ref": "#/$defs/sha" },
        "clean": { "const": true },
        "deviceBranchScriptDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "canonical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryPath",
        "canonicalPath",
        "origin",
        "targetRepository",
        "headSha",
        "originMainSha",
        "remoteMainSha",
        "treeSha",
        "clean",
        "canonicalSourceDisposition",
        "canonicalLaneStateDigest",
        "registryDigest",
        "laneSetDigest",
        "existingLanes"
      ],
      "properties": {
        "repositoryPath": { "$ref": "#/$defs/absolutePath" },
        "canonicalPath": { "$ref": "#/$defs/absolutePath" },
        "origin": {
          "type": "string",
          "pattern": "^(git@github\\.com:|https://github\\.com/)[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\\.git)?$"
        },
        "targetRepository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "headSha": { "$ref": "#/$defs/sha" },
        "originMainSha": { "$ref": "#/$defs/sha" },
        "remoteMainSha": { "$ref": "#/$defs/sha" },
        "treeSha": { "$ref": "#/$defs/sha" },
        "clean": { "const": true },
        "canonicalSourceDisposition": { "const": "exact" },
        "canonicalLaneStateDigest": { "$ref": "#/$defs/digest" },
        "registryDigest": { "$ref": "#/$defs/digest" },
        "laneSetDigest": { "$ref": "#/$defs/digest" },
        "existingLanes": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "stateDigest"],
            "properties": {
              "path": { "$ref": "#/$defs/absolutePath" },
              "stateDigest": { "$ref": "#/$defs/digest" }
            }
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticScope",
        "deviceId",
        "branch",
        "sessionId",
        "targetPath",
        "targetObservationDigest",
        "ttlSeconds",
        "selectionPath",
        "selectionFileDigest",
        "manifestPath",
        "manifestFileDigest",
        "manifest",
        "cloudAuthorityPath",
        "cloudAuthorityFileDigest",
        "cloudAuthority",
        "candidateClaim",
        "candidateClaimRecordDigest"
      ],
      "properties": {
        "semanticScope": { "type": "string", "minLength": 1 },
        "deviceId": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "targetPath": { "$ref": "#/$defs/absolutePath" },
        "targetObservationDigest": { "$ref": "#/$defs/digest" },
        "ttlSeconds": { "type": "integer", "minimum": 1 },
        "selectionPath": { "$ref": "#/$defs/absolutePath" },
        "selectionFileDigest": { "$ref": "#/$defs/digest" },
        "manifestPath": { "$ref": "#/$defs/absolutePath" },
        "manifestFileDigest": { "$ref": "#/$defs/digest" },
        "manifest": { "type": "object" },
        "cloudAuthorityPath": { "$ref": "#/$defs/absolutePath" },
        "cloudAuthorityFileDigest": { "$ref": "#/$defs/digest" },
        "cloudAuthority": { "type": "object" },
        "candidateClaim": { "$ref": "#/$defs/cloudClaim" },
        "candidateClaimRecordDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "cloudInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ledgerRevision",
        "ledgerDigest",
        "claims",
        "inventoryStateDigest"
      ],
      "properties": {
        "schema": {
          "const": "agentic-dormant-preservation-admission-cloud-inventory/v1"
        },
        "ledgerRevision": { "$ref": "#/$defs/sha" },
        "ledgerDigest": { "$ref": "#/$defs/digest" },
        "claims": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/cloudClaim" }
        },
        "inventoryStateDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "cloudClaim": {
      "type": "object",
      "required": ["claimId", "state", "recordDigest"],
      "properties": {
        "claimId": { "$ref": "#/$defs/digest" },
        "state": { "type": "string", "minLength": 1 },
        "recordDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "preservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authenticatedActor",
        "repository",
        "sessionId",
        "selectedLanes",
        "selectionDigest",
        "projectionDigest"
      ],
      "properties": {
        "authenticatedActor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actorId", "login"],
          "properties": {
            "actorId": { "type": "string", "minLength": 1 },
            "login": { "type": "string", "minLength": 1 }
          }
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "nameWithOwner", "ownerLogin", "path"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "nameWithOwner": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "ownerLogin": { "type": "string", "minLength": 1 },
            "path": { "$ref": "#/$defs/absolutePath" }
          }
        },
        "sessionId": { "type": "string", "minLength": 1 },
        "selectedLanes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/selectedLane" }
        },
        "selectionDigest": { "$ref": "#/$defs/digest" },
        "projectionDigest": {
          "$ref": "#/$defs/digest",
          "description": "Stable dormant-preservation receipt projection digest; excludes the outer seal, verification time, operator-decision cycle, and cloud observation receipt digest."
        }
      }
    },
    "selectedLane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "stateDigest",
        "worktree",
        "pullRequest",
        "selectionDigest"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "stateDigest": { "$ref": "#/$defs/digest" },
        "worktree": {
          "type": "object",
          "required": ["path", "branch", "headSha", "treeSha", "stateDigest"],
          "properties": {
            "path": { "$ref": "#/$defs/absolutePath" },
            "branch": {
              "anyOf": [
                { "type": "string", "minLength": 1 },
                { "type": "null" }
              ]
            },
            "detached": { "type": "boolean" },
            "headSha": { "$ref": "#/$defs/sha" },
            "treeSha": { "$ref": "#/$defs/sha" },
            "stateDigest": { "$ref": "#/$defs/digest" }
          },
          "oneOf": [
            {
              "required": ["detached"],
              "properties": {
                "branch": { "type": "null" },
                "detached": { "const": true }
              }
            },
            {
              "properties": {
                "branch": { "type": "string", "minLength": 1 },
                "detached": { "const": false }
              }
            }
          ]
        },
        "pullRequest": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["number", "url", "headSha", "branch", "headRepository"],
              "properties": {
                "number": { "type": "integer", "minimum": 1 },
                "url": {
                  "type": "string",
                  "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[1-9][0-9]*$"
                },
                "headSha": { "$ref": "#/$defs/sha" },
                "branch": { "type": "string", "minLength": 1 },
                "headRepository": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                }
              }
            }
          ]
        },
        "selectionDigest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
