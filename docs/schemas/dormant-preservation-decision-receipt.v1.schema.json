{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-canvas-os.local/schemas/dormant-preservation-decision-receipt.v1.schema.json",
  "responsibility": "Validate terminal receipt evidence for one authorized dormant-preservation admission.",
  "title": "Dormant-preservation admission receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "planDigest",
    "authorizationDigest",
    "admittedIntentDigest",
    "operationKey",
    "sourceEvidenceDigest",
    "deviceStartArgvDigest",
    "dormantPreservationReceiptDigest",
    "admissionReportDigest",
    "admissionReceiptDigest",
    "preservationReceiptDigest",
    "mutationAuthorityReceiptDigest",
    "candidateStateDigest",
    "candidateLeaseDigest",
    "finalLaneSetDigest",
    "pullRequestNumber",
    "pullRequestHeadSha",
    "finalClaimId",
    "finalClaimRecordDigest",
    "finalInventoryStateDigest",
    "executionEvidenceDigest",
    "receiptDigest"
  ],
  "properties": {
    "schema": {
      "const": "agentic-dormant-preservation-admission-receipt/v1"
    },
    "status": {
      "const": "admitted"
    },
    "planDigest": { "$ref": "#/$defs/digest" },
    "authorizationDigest": { "$ref": "#/$defs/digest" },
    "admittedIntentDigest": { "$ref": "#/$defs/digest" },
    "operationKey": { "$ref": "#/$defs/digest" },
    "sourceEvidenceDigest": { "$ref": "#/$defs/digest" },
    "deviceStartArgvDigest": { "$ref": "#/$defs/digest" },
    "dormantPreservationReceiptDigest": {
      "$ref": "#/$defs/digest",
      "description": "Stable semantic dormant-preservation receipt projection digest, not a volatile operation receipt seal."
    },
    "admissionReportDigest": { "$ref": "#/$defs/digest" },
    "admissionReceiptDigest": { "$ref": "#/$defs/digest" },
    "preservationReceiptDigest": { "$ref": "#/$defs/digest" },
    "mutationAuthorityReceiptDigest": {
      "$ref": "#/$defs/digest",
      "description": "Stable semantic mutation-authority projection digest excluding evaluatedAt and the cloud verification observation digest."
    },
    "candidateStateDigest": { "$ref": "#/$defs/digest" },
    "candidateLeaseDigest": { "$ref": "#/$defs/digest" },
    "finalLaneSetDigest": { "$ref": "#/$defs/digest" },
    "pullRequestNumber": {
      "type": "integer",
      "minimum": 1
    },
    "pullRequestHeadSha": { "$ref": "#/$defs/sha" },
    "finalClaimId": { "$ref": "#/$defs/digest" },
    "finalClaimRecordDigest": { "$ref": "#/$defs/digest" },
    "finalInventoryStateDigest": { "$ref": "#/$defs/digest" },
    "executionEvidenceDigest": { "$ref": "#/$defs/digest" },
    "receiptDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
