{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-canvas-os.local/schemas/expired-active-dirty-scope-expansion-recovery-plan.v1.schema.json",
  "responsibility": "Validate one exact source-evidence-bound expired active-dirty scope-expansion recovery plan.",
  "title": "Expired active-dirty scope-expansion recovery plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "sourceEvidence",
    "sourceEvidenceDigest",
    "ttlSeconds",
    "planDigest",
    "exactAuthorization"
  ],
  "properties": {
    "schema": {
      "const": "agentic-expired-active-dirty-scope-expansion-recovery-plan/v1"
    },
    "operation": {
      "const": "expired-active-dirty-scope-expansion-recovery"
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "controller",
        "lane",
        "lease",
        "leaseDigest",
        "cloud",
        "pullRequest",
        "dirt",
        "scopeExpansionIntent",
        "sourceEvidenceDigest"
      ],
      "properties": {
        "schema": {
          "const": "agentic-expired-active-dirty-scope-expansion-recovery-source-evidence/v1"
        },
        "controller": { "type": "object" },
        "lane": { "type": "object" },
        "lease": { "type": "object" },
        "leaseDigest": { "$ref": "#/$defs/digest" },
        "cloud": { "type": "object" },
        "pullRequest": { "type": "object" },
        "dirt": { "type": "object" },
        "scopeExpansionIntent": { "type": "null" },
        "sourceEvidenceDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "sourceEvidenceDigest": { "$ref": "#/$defs/digest" },
    "ttlSeconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 86400
    },
    "planDigest": { "$ref": "#/$defs/digest" },
    "exactAuthorization": {
      "type": "string",
      "pattern": "^authorize expired-active-dirty-scope-expansion-recovery [0-9a-f]{64}$"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
