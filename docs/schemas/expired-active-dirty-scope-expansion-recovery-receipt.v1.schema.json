{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-canvas-os.local/schemas/expired-active-dirty-scope-expansion-recovery-receipt.v1.schema.json",
  "responsibility": "Validate the deterministic terminal receipt for one exact authorized recovery intent.",
  "title": "Expired active-dirty scope-expansion recovery receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "planDigest",
    "sourceEvidenceDigest",
    "authorizationDigest",
    "completeIntentDigest",
    "cloudRecoveredOperationKey",
    "cloudRecoveredObservationDigest",
    "localReboundOperationKey",
    "localReboundObservationDigest",
    "prProjectionOperationKey",
    "prProjectionObservationDigest",
    "completionOperationKey",
    "completionObservationDigest",
    "receiptDigest"
  ],
  "properties": {
    "schema": {
      "const": "agentic-expired-active-dirty-scope-expansion-recovery-receipt/v1"
    },
    "status": { "const": "recovered" },
    "planDigest": { "$ref": "#/$defs/digest" },
    "sourceEvidenceDigest": { "$ref": "#/$defs/digest" },
    "authorizationDigest": { "$ref": "#/$defs/digest" },
    "completeIntentDigest": { "$ref": "#/$defs/digest" },
    "cloudRecoveredOperationKey": { "$ref": "#/$defs/digest" },
    "cloudRecoveredObservationDigest": { "$ref": "#/$defs/digest" },
    "localReboundOperationKey": { "$ref": "#/$defs/digest" },
    "localReboundObservationDigest": { "$ref": "#/$defs/digest" },
    "prProjectionOperationKey": { "$ref": "#/$defs/digest" },
    "prProjectionObservationDigest": { "$ref": "#/$defs/digest" },
    "completionOperationKey": { "$ref": "#/$defs/digest" },
    "completionObservationDigest": { "$ref": "#/$defs/digest" },
    "receiptDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
