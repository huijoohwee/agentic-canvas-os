{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-canvas-os.dev/schemas/task-bound-lane-authority/v1",
  "title": "Task-Bound Lane Authority v1",
  "oneOf": [
    { "$ref": "#/$defs/capability" },
    { "$ref": "#/$defs/binding" },
    { "$ref": "#/$defs/proof" },
    { "$ref": "#/$defs/transitionPlan" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "subject": { "type": "string", "pattern": "^urn:agentic-task:[0-9a-f]{64}$" },
    "adapter": { "const": "urn:agentic-proof:ed25519-file:v1" },
    "generation": { "type": "integer", "minimum": 1 },
    "instant": { "type": "string", "format": "date-time" },
    "projectedCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoritySubjectId",
        "proofAdapterId",
        "generation",
        "publicKey",
        "publicKeyDigest"
      ],
      "properties": {
        "authoritySubjectId": { "$ref": "#/$defs/subject" },
        "proofAdapterId": { "$ref": "#/$defs/adapter" },
        "generation": { "$ref": "#/$defs/generation" },
        "publicKey": { "type": "string", "minLength": 32 },
        "publicKeyDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "authoritySubjectId",
        "proofAdapterId",
        "generation",
        "publicKey",
        "privateKey",
        "issuedAt"
      ],
      "properties": {
        "schema": { "const": "agentic-task-authority-capability/v1" },
        "authoritySubjectId": { "$ref": "#/$defs/subject" },
        "proofAdapterId": { "$ref": "#/$defs/adapter" },
        "generation": { "$ref": "#/$defs/generation" },
        "publicKey": { "type": "string", "minLength": 32 },
        "privateKey": { "type": "string", "pattern": "^-----BEGIN PRIVATE KEY-----" },
        "issuedAt": { "$ref": "#/$defs/instant" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "authoritySubjectId",
        "proofAdapterId",
        "generation",
        "publicKey",
        "publicKeyDigest",
        "laneBindingDigest",
        "bindingMode",
        "boundAt",
        "transitionPlanDigest",
        "priorBindingDigest",
        "bindingDigest"
      ],
      "properties": {
        "schema": { "const": "agentic-task-authority-binding/v1" },
        "authoritySubjectId": { "$ref": "#/$defs/subject" },
        "proofAdapterId": { "$ref": "#/$defs/adapter" },
        "generation": { "$ref": "#/$defs/generation" },
        "publicKey": { "type": "string", "minLength": 32 },
        "publicKeyDigest": { "$ref": "#/$defs/digest" },
        "laneBindingDigest": { "$ref": "#/$defs/digest" },
        "bindingMode": { "enum": ["claim", "continuation", "migration", "handoff"] },
        "boundAt": { "$ref": "#/$defs/instant" },
        "transitionPlanDigest": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }]
        },
        "priorBindingDigest": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }]
        },
        "bindingDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "bindingDigest", "leaseDigest", "issuedAt", "nonce"],
      "properties": {
        "operation": { "type": "string", "minLength": 1 },
        "bindingDigest": { "$ref": "#/$defs/digest" },
        "leaseDigest": { "$ref": "#/$defs/digest" },
        "issuedAt": { "$ref": "#/$defs/instant" },
        "nonce": { "$ref": "#/$defs/digest" }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "authoritySubjectId",
        "proofAdapterId",
        "generation",
        "challenge",
        "signature",
        "proofDigest"
      ],
      "properties": {
        "schema": { "const": "agentic-task-authority-proof/v1" },
        "authoritySubjectId": { "$ref": "#/$defs/subject" },
        "proofAdapterId": { "$ref": "#/$defs/adapter" },
        "generation": { "$ref": "#/$defs/generation" },
        "challenge": { "$ref": "#/$defs/challenge" },
        "signature": { "type": "string", "minLength": 64 },
        "proofDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "scope", "device", "epoch", "baseSha", "cloudClaimId"],
      "properties": {
        "branch": { "type": "string", "pattern": "^agent/.+/.+$" },
        "scope": { "type": "string", "minLength": 1 },
        "device": { "type": "string", "minLength": 1 },
        "epoch": { "$ref": "#/$defs/generation" },
        "baseSha": { "$ref": "#/$defs/sha" },
        "cloudClaimId": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }]
        }
      }
    },
    "transitionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation",
        "lane",
        "leaseDigest",
        "headSha",
        "worktreeStateDigest",
        "currentBindingDigest",
        "target",
        "plannedAt",
        "planDigest",
        "exactAuthorization"
      ],
      "properties": {
        "schema": { "const": "agentic-task-authority-transition-plan/v1" },
        "operation": { "enum": ["migration", "handoff"] },
        "lane": { "$ref": "#/$defs/lane" },
        "leaseDigest": { "$ref": "#/$defs/digest" },
        "headSha": { "$ref": "#/$defs/sha" },
        "worktreeStateDigest": { "$ref": "#/$defs/digest" },
        "currentBindingDigest": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }]
        },
        "target": { "$ref": "#/$defs/projectedCapability" },
        "plannedAt": { "$ref": "#/$defs/instant" },
        "planDigest": { "$ref": "#/$defs/digest" },
        "exactAuthorization": { "type": "string", "minLength": 1 }
      }
    }
  }
}
