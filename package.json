    "smoke": "node ./scripts/smoke.mjs",
    "test": "node --test __tests__/*.test.mjs",
    "web:build": "node web/build.mjs",
    "cloudflare:dev": "npm run web:build && wrangler dev",
    "dictionary:project": "node ./scripts/dictionary-projections.mjs --write",
    "check:source": "npm test && npm run web:build && npm run docs:check && npm run authored-line-budget:check",
    "check:plan": "node node_modules/agentic-os/bin/agentic-os-validation.mjs plan",
    "check:ci": "node node_modules/agentic-os/bin/agentic-os-validation.mjs ci",
    "check:all": "node node_modules/agentic-os/bin/agentic-os-validation.mjs run --all --fresh",
    "test:shard:1": "node --test --test-shard=1/4 __tests__/*.test.mjs",
    "test:shard:2": "node --test --test-shard=2/4 __tests__/*.test.mjs",
    "test:shard:3": "node --test --test-shard=3/4 __tests__/*.test.mjs",
    "test:shard:4": "node --test --test-shard=4/4 __tests__/*.test.mjs",
    "check:budgets:source": "npm --prefix node_modules/agentic-os run evals && npm run authored-line-budget:check && node --test __tests__/adlc-compatibility.test.mjs __tests__/agentic-os-profile.test.mjs && npm run dictionary-catalog:check"
  },
  "devDependencies": {
