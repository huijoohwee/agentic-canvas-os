    "probe-tree-contract:check": "node --test __tests__/probe-tree-contract.test.mjs && npm run docs:check",
    "repository-packing-contract:check": "node --test __tests__/repository-packing-contract.test.mjs && node ./scripts/repository-packing-contract.mjs",
    "repository-runtime-readiness:check": "node --test __tests__/repository-runtime-readiness.test.mjs",
    "repository-runtime-readiness:audit": "node ./scripts/repository-runtime-readiness.mjs",
    "collaboration:gate": "node ./scripts/collaboration-gate.mjs",
    "coordination:schedule": "node ./scripts/coordination-scheduler.mjs",
