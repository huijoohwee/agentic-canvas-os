    "land": "agentic-os land",
    "successor": "agentic-os successor",
    "status": "agentic-os status",
    "reap": "agentic-os reap",
    "finish": "agentic-os finish",
    "release:common": "node ./scripts/release-common.mjs",
    "queue:show": "agentic-os queue show",
    "autonomy-class": "agentic-os autonomy-class",
    "git:configure": "agentic-os git-configure",
    "sync:canonical": "agentic-os canonical-sync",
    "runtime:local:ensure": "node ./scripts/local-runtime.mjs ensure",
    "runtime:local:status": "node ./scripts/local-runtime.mjs status",
    "runtime:local:stop": "node ./scripts/local-runtime.mjs stop",
    "runtime:session:start": "node ./scripts/local-runtime.mjs session-start",
    "runtime:session:status": "node ./scripts/local-runtime.mjs session-status",
    "runtime:session:stop": "node ./scripts/local-runtime.mjs session-stop",
    "turn:end": "node ./scripts/local-runtime.mjs turn-end",
