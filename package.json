    "fast-check": "3.23.2",
    "wrangler": "4.120.0",
    "agentic-commerce-os": "https://codeload.github.com/huijoohwee/agentic-commerce-os/tar.gz/a632166eb8e4258f55301b5089aa78da663e0d21"
  },
  "overrides": {
